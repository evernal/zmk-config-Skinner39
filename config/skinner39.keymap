#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <5 15 25 26 16 6 7 17 27 28 18 8 9 19 29 38 37 36>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q            &kp W            &kp E                &kp R              &kp T                                    &kp Y            &kp U               &kp I                 &kp O             &kp P
  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G                                    &kp H            &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI APOSTROPHE
  &kp Z            &kp X            &kp C                &kp V              &kp B                                    &kp N            &kp M               &kp COMMA             &kp PERIOD        &kp SLASH
  &lt 7 ESCAPE     &kp LC(LS(K))    &kp LC(SPACE)        &lt 5 ESCAPE       &lt 6 SPACE  &lt 4 LA(TAB)  &lt 2 ENTER  &lt 1 BACKSPACE                                                              &lt 3 DELETE
            >;
        };

        number_layer {
            bindings = <
  &kp LEFT_BRACE  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACE                    &none   &none            &none             &none          &none
  &kp SEMI        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                          &none   &kp RIGHT_SHIFT  &kp LEFT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
  &kp GRAVE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH                      &none   &none            &none             &none          &none
  &none           &none         &none         &kp PERIOD    &kp NUMBER_0     &kp MINUS  &none  &trans                                                    &none
            >;
        };

        symbol_layer {
            bindings = <
  &kp LEFT_BRACE  &kp AMPS    &kp ASTRK    &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE                           &none  &none            &none              &none          &none
  &kp COLON       &kp DOLLAR  &kp PERCENT  &kp CARET             &kp PLUS                                  &none  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
  &kp TILDE       &kp EXCL    &kp AT       &kp POUND             &kp PIPE                                  &none  &none            &none              &none          &none
  &none           &none       &none        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &trans  &none                                                     &none
            >;
        };

        function_layer {
            bindings = <
  &kp F12  &kp F7  &kp F8  &kp F9      &kp PRINTSCREEN                  &none  &none            &none              &none          &none
  &kp F11  &kp F4  &kp F5  &kp F6      &kp SCROLLLOCK                   &none  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
  &kp F10  &kp F1  &kp F2  &kp F3      &kp PAUSE_BREAK                  &none  &none            &none              &none          &none
  &none    &none   &none   &kp ESCAPE  &kp SPACE        &kp TAB  &none  &none                                                     &trans
            >;
        };

        mouse_layer {
            bindings = <
  &none         &none         &none             &none           &none                 &kp K_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &kp K_UNDO
  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none                 &none       &mkp LCLK    &mkp MCLK   &mkp RCLK  &none
  &none         &none         &none             &none           &none                 &none       &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT
  &none         &none         &none             &none           &none  &trans  &none  &none                                           &none
            >;
        };

        scroll_layer {
            bindings = <
  &none         &none         &none             &none           &none                    &kp K_REDO     &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp K_UNDO
  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none                    &caps_word     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
  &none         &none         &none             &none           &none                    &kp INSERT     &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END
  &none         &none         &none             &trans          &none  &none  &kp ENTER  &kp BACKSPACE                                                &kp DELETE
            >;
        };

        snipe_layer {
            bindings = <
  &none         &none         &none             &none           &none                 &trans  &trans     &trans     &trans     &trans
  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none                 &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
  &none         &none         &none             &none           &none                 &none   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT
  &none         &none         &none             &none           &trans  &none  &none  &none                                    &trans
            >;
        };

        customizable_layer {
            bindings = <
  &none   &none  &none  &none  &bootloader                     &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4
  &none   &none  &none  &none  &none                           &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
  &none   &none  &none  &none  &none                           &none          &none          &none          &none          &bt BT_CLR
  &trans  &none  &none  &none  &none        &none  &bt BT_PRV  &bt BT_NXT                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
